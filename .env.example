# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60
MQTT_TELEMETRY_TOPIC=iot/devices/+/telemetry
MQTT_ALERT_TOPIC=iot/alerts

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-iot-token-12345
INFLUXDB_ORG=iot_security_org
INFLUXDB_BUCKET=iot_telemetry

# Model Parameters
MODEL_PATH=models/isolation_forest.joblib
CONTAMINATION_RATE=0.05
RANDOM_STATE=42

# Simulator Settings
SIMULATION_INTERVAL_SEC=2.0
NUM_DEVICES=3
